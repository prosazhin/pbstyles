{
  "name": "@prosazhin/pbstyles",
  "version": "1.5.0",
  "description": "Basic styles for quick prototyping",
  "license": "MIT",
  "author": "Evgenii Sazhin <prosazhin@gmail.com> (https://prosazhin.dev)",
  "keywords": [
    "style",
    "css",
    "less",
    "scss",
    "tailwind",
    "tailwind v4",
    "tailwind-theme",
    "tailwind-theme v4",
    "theme",
    "design",
    "tokens",
    "tool",
    "system",
    "design-tokens",
    "design-system",
    "design-tool",
    "dtcg"
  ],
  "homepage": "https://github.com/prosazhin/pbstyles",
  "repository": {
    "type": "git",
    "url": "https://github.com/prosazhin/pbstyles.git"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "files": [
    "styles",
    "README.md",
    "README.ru.md"
  ],
  "scripts": {
    "build": "npm run build:mixin-dictionary && npm run build:tailwind-dictionary && npm run format",
    "build:mixin-dictionary": "mixin-dictionary -c './config-mixin-dictionary.json'",
    "build:tailwind-dictionary": "tailwind-dictionary -c './config-tailwind-dictionary.json'",
    "lint": "eslint",
    "format": "prettier --write styles",
    "prepare": "npx simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged --concurrent false",
    "pre-push": "npm run format",
    "commit-msg": "npx --no-install commitlint --edit ${1}"
  },
  "lint-staged": {
    "*.{md,mdx,css,scss,less,js,json}": "prettier --write",
    "*.{md,mdx,css,scss,less,js}": "eslint --cache --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "overrides": {
    "fast-uri": "~3.1.9",
    "qs": "~6.16.0",
    "js-yaml": "~4.3.2",
    "brace-expansion": "~5.0.12",
    "style-dictionary": "~5.5.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^17.6.0",
    "mixin-dictionary": "^1.7.2",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "tailwind-dictionary": "^2.6.2"
  }
}
